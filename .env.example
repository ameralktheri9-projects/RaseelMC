# Copy this file to .env and fill in real values. .env is gitignored.

# Neon Postgres connection string — use the POOLED ("-pooler") connection string from the
# Neon dashboard, not the direct one, since Vercel serverless functions open many short-lived
# connections and the pooler (PgBouncer) multiplexes them upstream.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/raseel-mc?sslmode=require

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Long random string Vercel Cron must present (as "Authorization: Bearer <value>") to hit
# /api/cron/daily. Set the same value in the Vercel project's environment variables.
CRON_SECRET=

PORT=3000
NODE_ENV=development

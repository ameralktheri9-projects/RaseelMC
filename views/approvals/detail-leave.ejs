<%- include('../partials/head', { title, lang }) %>
<%- include('../partials/app-shell-start', { lang, title, currentUser, currentPath }) %>

<a href="/approvals" class="small d-inline-block mb-3">&larr; <%= t(lang, 'common.back') %></a>

<div class="row">
  <div class="col-lg-8">
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <h2 class="h5 mb-1"><%= lang === 'ar' ? request.type_name_ar : request.type_name_en %></h2>
            <p class="text-muted small mb-0">
              <%= lang === 'ar' ? request.emp_name_ar : request.emp_name_en %> &middot; <%= request.job_title %> &middot; <%= request.employee_code %>
            </p>
          </div>
          <span class="badge badge-status-<%= request.status %> fs-6"><%= request.status %></span>
        </div>

        <div class="row text-center border rounded py-2 mb-3">
          <div class="col">
            <div class="fw-bold"><%= request.start_date %> &ndash; <%= request.end_date %></div>
            <div class="text-muted small"><%= lang === 'ar' ? 'التواريخ' : 'Dates' %></div>
          </div>
          <div class="col">
            <div class="fw-bold"><%= request.working_days %></div>
            <div class="text-muted small"><%= lang === 'ar' ? 'أيام العمل' : 'Working days' %></div>
          </div>
          <div class="col">
            <div class="fw-bold"><%= balance.remaining %> <%= lang === 'ar' ? 'من' : 'of' %> <%= balance.remaining + request.working_days %></div>
            <div class="text-muted small"><%= lang === 'ar' ? 'الرصيد بعد الموافقة' : 'Balance after' %></div>
          </div>
        </div>

        <% if (request.reason) { %>
          <div class="mb-2"><span class="text-muted small"><%= lang === 'ar' ? 'السبب' : 'Reason' %>:</span> <%= request.reason %></div>
        <% } %>
        <% if (request.handover_name_en) { %>
          <div class="mb-2"><span class="text-muted small"><%= lang === 'ar' ? 'التسليم إلى' : 'Handover to' %>:</span> <%= lang === 'ar' ? request.handover_name_ar : request.handover_name_en %></div>
        <% } %>

        <% if (canAct) { %>
          <form method="POST" action="/approvals/leave/<%= request.id %>/action" class="mt-4 border-top pt-3">
            <div class="mb-3">
              <label class="form-label fw-semibold"><%= lang === 'ar' ? 'ملاحظة (مطلوبة للرفض أو الإرجاع)' : 'Comment (required to reject or return)' %></label>
              <textarea name="comment" class="form-control" rows="2"></textarea>
            </div>
            <div class="d-flex gap-2">
              <button type="submit" name="action" value="reject" class="btn btn-outline-danger"><%= lang === 'ar' ? 'رفض' : 'Reject' %></button>
              <button type="submit" name="action" value="return" class="btn btn-outline-secondary"><%= lang === 'ar' ? 'إرجاع للتعديل' : 'Return for edit' %></button>
              <button type="submit" name="action" value="approve" class="btn btn-success ms-auto"><%= lang === 'ar' ? 'موافقة' : 'Approve' %></button>
            </div>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <h3 class="h6 mb-3"><%= lang === 'ar' ? 'مسار الموافقة' : 'Approval trail' %></h3>
        <% if (!trail || trail.length === 0) { %>
          <p class="text-muted small mb-0">&mdash;</p>
        <% } else { %>
          <ul class="list-unstyled mb-0">
            <% trail.forEach(function(a) { %>
              <li class="mb-2 small">
                <strong><%= a.action %></strong>
                <% if (a.approver_name_en) { %> &middot; <%= lang === 'ar' ? a.approver_name_ar : a.approver_name_en %><% } %>
                <div class="text-muted"><%= a.created_at %></div>
                <% if (a.comment) { %><div class="text-muted fst-italic">"<%= a.comment %>"</div><% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/app-shell-end') %>
<%- include('../partials/scripts') %>

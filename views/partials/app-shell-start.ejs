<%
  const roles = (currentUser && currentUser.roles) || [];
  const isAdminOrHr = roles.includes('system_admin') || roles.includes('hr_officer');
  const isAdmin = roles.includes('system_admin');
  const canSeeReports = isAdminOrHr || roles.includes('finance');
  const hasEmployeeProfile = currentUser && currentUser.employeeId != null;

  const workspaceItems = [
    { href: '/dashboard', key: 'nav.dashboard', icon: '&#8962;' },
  ];
  if (hasEmployeeProfile) {
    workspaceItems.push({ href: '/leave', key: 'nav.myLeave', icon: '&#128197;' });
    workspaceItems.push({ href: '/loans', key: 'nav.myLoans', icon: '&#128179;' });
  }
  workspaceItems.push({ href: '/approvals', key: 'nav.approvals', icon: '&#9989;' });
  workspaceItems.push({ href: '/profile', key: 'nav.profile', icon: '&#128100;' });

  // Only items this user actually has access to — a role-gated item that's merely shown-but-disabled
  // to everyone else just adds clutter for accounts (e.g. plain employees) that will never use it.
  const managementItems = [];
  if (canSeeReports) managementItems.push({ href: '/reports', key: 'nav.reports', icon: '&#128202;' });
  if (isAdminOrHr) managementItems.push({ href: '/settings', key: 'nav.settings', icon: '&#9881;' });
  if (isAdmin) managementItems.push({ href: '/audit-log', key: 'nav.auditLog', icon: '&#128220;' });

  const roleLabels = [];
  if (roles.includes('system_admin')) roleLabels.push(lang === 'ar' ? 'مدير النظام' : 'System Admin');
  if (roles.includes('hr_officer')) roleLabels.push(lang === 'ar' ? 'شؤون الموظفين' : 'HR Officer');
  if (roles.includes('finance')) roleLabels.push(lang === 'ar' ? 'المالية' : 'Finance');
  if (!roleLabels.length) roleLabels.push(lang === 'ar' ? 'موظف' : 'Employee');

  const displayName = (lang === 'ar' ? currentUser.nameAr : currentUser.nameEn) || currentUser.nameEn || '';
  const initials = (currentUser.nameEn || '?').split(' ').map(function (w) { return w[0]; }).slice(0, 2).join('').toUpperCase();

  function navLink(item) {
    var active = currentPath && currentPath.startsWith(item.href);
    return '<a href="' + item.href + '" class="' + (active ? 'active' : '') + '"><span class="ico">' + item.icon + '</span><span>' + t(lang, item.key) + '</span></a>';
  }
%>
<div class="shell<%= lang === 'ar' ? ' rtl' : '' %>">
  <aside class="rail">
    <div class="brand">
      <img src="/images/logo.png" alt="Raseel MC">
    </div>
    <div class="role">
      <b><%= displayName %></b>
      <%= roleLabels.join(' · ') %>
    </div>

    <div class="nav-label"><%= lang === 'ar' ? 'مساحة العمل' : 'Workspace' %></div>
    <nav class="rail-nav">
      <%- workspaceItems.map(navLink).join('') %>
    </nav>

    <% if (managementItems.length) { %>
      <div class="nav-label"><%= lang === 'ar' ? 'الإدارة' : 'Management' %></div>
      <nav class="rail-nav">
        <%- managementItems.map(navLink).join('') %>
      </nav>
    <% } %>

    <div class="rail-user">
      <div class="avatar"><%= initials %></div>
      <div>
        <div style="font-size:13px;font-weight:600;color:#fff;"><%= displayName %></div>
        <small><%= currentUser.username %></small>
      </div>
    </div>
  </aside>

  <div class="main">
    <div class="top">
      <div class="top-left">
        <div class="page-title"><%= title %></div>
      </div>
      <div class="top-actions">
        <form method="POST" action="/set-language" class="m-0">
          <input type="hidden" name="lang" value="<%= lang === 'ar' ? 'en' : 'ar' %>">
          <button type="submit" class="lang"><%= lang === 'ar' ? 'EN' : 'عربي' %></button>
        </form>
        <div class="dropdown">
          <button class="icon-btn position-relative" data-bs-toggle="dropdown" id="notif-bell">
            &#128276;
            <span class="notif-badge d-none" id="notif-badge"></span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end p-0" style="min-width:320px;" id="notif-list">
            <li class="dropdown-item-text small text-muted py-2"><%= lang === 'ar' ? 'جارٍ التحميل...' : 'Loading...' %></li>
          </ul>
        </div>
        <div class="dropdown">
          <button class="avatar" style="border:0;" data-bs-toggle="dropdown"><%= initials %></button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><span class="dropdown-item-text small text-muted"><%= displayName %></span></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form method="POST" action="/logout" class="m-0">
                <button type="submit" class="dropdown-item"><%= t(lang, 'nav.logout') %></button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div class="content">

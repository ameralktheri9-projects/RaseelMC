<%- include('../partials/head', { title, lang }) %>
<%- include('../partials/app-shell-start', { lang, title, currentUser, currentPath }) %>
<%- include('_tabs', { lang, currentPath }) %>

<% if (typeof resetPassword !== 'undefined' && resetPassword) { %>
  <div class="alert alert-success">
    <%= lang === 'ar' ? 'كلمة المرور المؤقتة الجديدة:' : 'New temporary password:' %> <code><%= resetPassword %></code>
    <div class="small"><%= lang === 'ar' ? 'سيُطلب من المستخدم تغييرها عند الدخول التالي.' : 'The user will be required to change it at their next login.' %></div>
  </div>
<% } %>

<% if (importResult) { %>
  <div class="alert <%= importResult.errors.length ? 'alert-warning' : 'alert-success' %>">
    <%= lang === 'ar' ? 'تم إنشاء' : 'Created' %> <strong><%= importResult.created %></strong> <%= lang === 'ar' ? 'موظف.' : 'employee(s).' %>
    <% if (importResult.errors.length) { %>
      <ul class="mb-0 small mt-2">
        <% importResult.errors.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>
  </div>
<% } %>
<% if (typeof leaveBalanceImportResult !== 'undefined' && leaveBalanceImportResult) { %>
  <div class="alert <%= leaveBalanceImportResult.errors.length ? 'alert-warning' : 'alert-success' %>">
    <%= lang === 'ar' ? 'تم تحديث رصيد' : 'Updated the leave balance for' %> <strong><%= leaveBalanceImportResult.updated %></strong> <%= lang === 'ar' ? 'موظف.' : 'employee(s).' %>
    <% if (leaveBalanceImportResult.errors.length) { %>
      <ul class="mb-0 small mt-2">
        <% leaveBalanceImportResult.errors.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>
  </div>
<% } %>
<% if (typeof loanImportResult !== 'undefined' && loanImportResult) { %>
  <div class="alert <%= loanImportResult.errors.length ? 'alert-warning' : 'alert-success' %>">
    <%= lang === 'ar' ? 'تم استيراد' : 'Imported' %> <strong><%= loanImportResult.created %></strong> <%= lang === 'ar' ? 'سلفة.' : 'loan(s).' %>
    <% if (loanImportResult.errors.length) { %>
      <ul class="mb-0 small mt-2">
        <% loanImportResult.errors.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>
  </div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h3 class="h5 mb-0"><%= lang === 'ar' ? 'الموظفون والمستخدمون' : 'Employees & users' %></h3>
  <div class="d-flex gap-2 flex-wrap">
    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#bulk-import">📄 <%= lang === 'ar' ? 'استيراد الموظفين' : 'Import employees' %></button>
    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#bulk-import-leave">📄 <%= lang === 'ar' ? 'استيراد أرصدة الإجازات' : 'Import leave balances' %></button>
    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#bulk-import-loans">📄 <%= lang === 'ar' ? 'استيراد السلف' : 'Import loans' %></button>
    <button class="btn btn-sm btn-primary" data-bs-toggle="collapse" data-bs-target="#new-emp">+ <%= lang === 'ar' ? 'موظف جديد' : 'New employee' %></button>
  </div>
</div>

<div class="collapse mb-3" id="bulk-import">
  <form method="POST" action="/settings/users/bulk-import" enctype="multipart/form-data" class="card card-body">
    <p class="small text-muted">
      <%= lang === 'ar'
        ? 'ارفع ملف Excel بالأعمدة الموضحة في النموذج (الاسم، القسم، تاريخ التعيين، تاريخ الميلاد، الجنسية، السجل التجاري، الكفالة، تاريخ ومدة العقد، تفاصيل الراتب، الحساب البنكي، وإنشاء حساب دخول).'
        : 'Upload an Excel file with the columns shown in the template (name, department, joining date, date of birth, nationality, commercial registration, sponsorship, contract start/period, salary breakdown, bank details, and create-account).' %>
      <a href="/settings/users/bulk-import-template.xlsx"><%= lang === 'ar' ? 'تنزيل نموذج' : 'Download template' %></a>
    </p>
    <div class="row g-2">
      <div class="col-md-9"><input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" required></div>
      <div class="col-md-3"><button type="submit" class="btn btn-sm btn-primary w-100"><%= lang === 'ar' ? 'استيراد' : 'Import' %></button></div>
    </div>
  </form>
</div>

<div class="collapse mb-3" id="bulk-import-leave">
  <form method="POST" action="/settings/leave-balances/bulk-import" enctype="multipart/form-data" class="card card-body">
    <p class="small text-muted">
      <%= lang === 'ar'
        ? 'لإدخال أرصدة الإجازات الحالية (المرحّل والمستهلك) للموظفين الموجودين مسبقاً. الموظف يجب أن يكون مُنشأً بالفعل (برقمه الوظيفي). يُستخدم هذا لمرة واحدة عند بدء تشغيل النظام.'
        : 'For entering existing employees\' current leave balances (carried-over and taken so far). The employee must already exist (matched by employee code). Meant for one-time use when first setting up the system.' %>
      <a href="/settings/leave-balances/bulk-import-template.xlsx"><%= lang === 'ar' ? 'تنزيل نموذج' : 'Download template' %></a>
    </p>
    <div class="row g-2">
      <div class="col-md-9"><input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" required></div>
      <div class="col-md-3"><button type="submit" class="btn btn-sm btn-primary w-100"><%= lang === 'ar' ? 'استيراد' : 'Import' %></button></div>
    </div>
  </form>
</div>

<div class="collapse mb-3" id="bulk-import-loans">
  <form method="POST" action="/settings/loans/bulk-import" enctype="multipart/form-data" class="card card-body">
    <p class="small text-muted">
      <%= lang === 'ar'
        ? 'لإدخال السلف الحالية (النشطة أو المنتهية) للموظفين. يتم إنشاؤها مباشرة بدون المرور بمسار الموافقة (باعتبارها سلفاً تمت الموافقة عليها مسبقاً)، مع جدول الأقساط كاملاً وتحديد عدد الأقساط المخصومة فعلياً.'
        : 'For entering existing (active or completed) loans. These are created directly without going through the approval workflow (treated as already-approved), with the full instalment schedule and however many instalments are already marked deducted.' %>
      <a href="/settings/loans/bulk-import-template.xlsx"><%= lang === 'ar' ? 'تنزيل نموذج' : 'Download template' %></a>
    </p>
    <div class="row g-2">
      <div class="col-md-9"><input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" required></div>
      <div class="col-md-3"><button type="submit" class="btn btn-sm btn-primary w-100"><%= lang === 'ar' ? 'استيراد' : 'Import' %></button></div>
    </div>
  </form>
</div>

<div class="collapse mb-3" id="new-emp">
  <form method="POST" action="/settings/users" class="card card-body">
    <div class="row g-2">
      <div class="col-md-3"><input name="employeeCode" class="form-control form-control-sm" placeholder="Employee code (e.g. RMC-2001)" required></div>
      <div class="col-md-3"><input name="nameEn" class="form-control form-control-sm" placeholder="Name (EN)" required></div>
      <div class="col-md-3"><input name="nameAr" class="form-control form-control-sm" placeholder="الاسم" dir="rtl" required></div>
      <div class="col-md-3">
        <select name="departmentId" class="form-select form-select-sm">
          <option value="">-- Department --</option>
          <% departments.forEach(function(d) { %><option value="<%= d.id %>"><%= lang === 'ar' ? d.name_ar : d.name_en %></option><% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <select name="jobTitle" class="form-select form-select-sm">
          <option value="">-- Position --</option>
          <% positions.forEach(function(p) { %><option value="<%= p.name_en %>"><%= lang === 'ar' ? p.name_ar : p.name_en %></option><% }) %>
        </select>
      </div>
      <div class="col-md-3"><input name="jobGrade" class="form-control form-control-sm" placeholder="Job grade"></div>
      <div class="col-md-3">
        <select name="directManagerId" class="form-select form-select-sm">
          <option value="">-- Direct manager --</option>
          <% employees.forEach(function(e) { %><option value="<%= e.id %>"><%= lang === 'ar' ? e.name_ar : e.name_en %></option><% }) %>
        </select>
      </div>
      <div class="col-md-3"><input type="date" name="joiningDate" class="form-control form-control-sm" required></div>
      <div class="col-md-3"><input type="number" name="grossSalary" class="form-control form-control-sm" placeholder="Gross salary (SAR)"></div>
      <div class="col-md-3 d-flex align-items-center">
        <label class="small"><input type="checkbox" name="createAccount" checked> <%= lang === 'ar' ? 'إنشاء حساب دخول' : 'Create login account' %></label>
      </div>
      <div class="col-12"><button class="btn btn-sm btn-primary" type="submit"><%= lang === 'ar' ? 'إنشاء' : 'Create' %></button></div>
    </div>
  </form>
</div>

<div class="card">
  <div class="card-body">
    <table class="table table-sm align-middle">
      <thead class="text-muted small"><tr><th><%= lang === 'ar' ? 'الموظف' : 'Employee' %></th><th><%= lang === 'ar' ? 'القسم' : 'Department' %></th><th><%= lang === 'ar' ? 'اسم المستخدم' : 'Username' %></th><th><%= lang === 'ar' ? 'الحالة' : 'Status' %></th><th></th></tr></thead>
      <tbody>
        <% employees.forEach(function(e) { %>
          <tr>
            <td><%= lang === 'ar' ? e.name_ar : e.name_en %> <span class="text-muted small"><%= e.employee_code %></span></td>
            <td><%= lang === 'ar' ? e.dept_ar : e.dept_en %></td>
            <td><%= e.username || '-' %></td>
            <td>
              <% if (e.user_id) { %>
                <span class="badge <%= e.user_active ? 'bg-success' : 'bg-secondary' %>"><%= e.user_active ? t(lang,'common.active') : t(lang,'common.inactive') %></span>
              <% } else { %>
                <span class="text-muted small"><%= lang === 'ar' ? 'لا يوجد حساب' : 'No account' %></span>
              <% } %>
            </td>
            <td class="text-end">
              <a href="/settings/users/<%= e.id %>/edit" class="btn btn-sm btn-outline-secondary"><%= t(lang, 'common.edit') %></a>
              <% if (e.user_id) { %>
                <form method="POST" action="/settings/users/<%= e.user_id %>/unlock" class="d-inline">
                  <button class="btn btn-sm btn-outline-secondary"><%= lang === 'ar' ? 'إلغاء القفل' : 'Unlock' %></button>
                </form>
                <form method="POST" action="/settings/users/<%= e.user_id %>/reset-password" class="d-inline" onsubmit="return confirm('<%= lang === 'ar' ? 'إعادة تعيين كلمة المرور؟' : 'Reset this user\'s password?' %>');">
                  <button class="btn btn-sm btn-outline-secondary"><%= lang === 'ar' ? 'إعادة تعيين كلمة المرور' : 'Reset password' %></button>
                </form>
                <form method="POST" action="/settings/users/<%= e.user_id %>/toggle-active" class="d-inline">
                  <button class="btn btn-sm btn-outline-danger"><%= e.user_active ? (lang === 'ar' ? 'تعطيل' : 'Deactivate') : (lang === 'ar' ? 'تفعيل' : 'Activate') %></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/app-shell-end') %>
<%- include('../partials/scripts') %>

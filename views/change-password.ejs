<%- include('partials/head', { title, lang }) %>

<div class="auth-shell d-flex align-items-center justify-content-center">
  <div class="auth-form-card">
    <div class="brand-logo mb-4">Raseel <span style="color:var(--rmc-accent)">MC</span></div>
    <h2 class="h3 mb-1"><%= t(lang, 'changePassword.title') %></h2>
    <p class="text-muted mb-4"><%= t(lang, 'changePassword.subtitle') %></p>

    <% if (error) { %>
      <div class="alert alert-danger py-2 small"><%= error %></div>
    <% } %>

    <form method="POST" action="/change-password">
      <div class="mb-3">
        <label class="form-label fw-semibold"><%= t(lang, 'changePassword.current') %></label>
        <input type="password" name="currentPassword" class="form-control form-control-lg" autocomplete="current-password" required autofocus>
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold"><%= t(lang, 'changePassword.new') %></label>
        <input type="password" name="newPassword" class="form-control form-control-lg" autocomplete="new-password" required>
        <div class="form-text"><%= t(lang, 'changePassword.requirements') %></div>
      </div>
      <div class="mb-4">
        <label class="form-label fw-semibold"><%= t(lang, 'changePassword.confirm') %></label>
        <input type="password" name="confirmPassword" class="form-control form-control-lg" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-lg w-100"><%= t(lang, 'changePassword.submit') %></button>
    </form>
  </div>
</div>

<%- include('partials/scripts') %>
